rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // FUNCTIONS
    // ========================================================================

    // Usuário autenticado no Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Dono do documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Perfil do usuário logado em users/{uid}
    function hasProfile() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Usuário com perfil ATIVO — camada real de segurança (plano Spark,
    // sem custom claims/Cloud Functions). Conta desativada perde todo acesso.
    function isActive() {
      return hasProfile() && myProfile().status == 'ATIVO';
    }

    // Admin: custom claim (legado) OU cargo ADMIN no perfil ativo
    function isAdmin() {
      return (isAuthenticated() && request.auth.token.admin == true)
        || (isActive() && myProfile().cargo == 'ADMIN');
    }

    // Cargos de liderança (validações e gestão)
    function isManager() {
      return isActive()
        && myProfile().cargo in ['ADMIN', 'DIRETOR', 'SUPERINTENDENTE', 'GERENTE', 'COORDENADOR'];
    }

    // Nível hierárquico de um cargo (espelha ROLE_HIERARCHY em notifications.js)
    function cargoLevel(cargo) {
      return cargo == 'ADMIN' ? 100
        : cargo == 'DIRETOR' ? 95
        : cargo == 'SUPERINTENDENTE' ? 90
        : cargo == 'GERENTE' ? 70
        : cargo == 'CONSULTOR' ? 60
        : cargo == 'COORDENADOR' ? 50
        : cargo == 'LIDER' ? 40
        : cargo == 'ANALISTA' ? 30
        : cargo == 'MONITOR' ? 10
        : cargo == 'VIEWER' ? 5
        : cargo == 'CONVIDADO' ? 1
        : 0;
    }

    // Papéis somente-leitura portados do Report Executivo: nunca escrevem em
    // coleções do módulo (viewer/convidado — ver docs/MODELO-DE-ACESSO.md do
    // app irmão, MANAGEMENT_ONLY_VIEWS).
    function isReportExecutivoReadOnly() {
      return isActive() && myProfile().cargo in ['VIEWER', 'CONVIDADO'];
    }

    // Gestor direto (1 nível, mesmo padrão de isDirectManagerOfTaskOwner) OU
    // gestor em qualquer nível acima na árvore, via cadeia_gestores
    // desnormalizada no perfil do usuário (ver SISTEMA de porte do Report
    // Executivo — Firestore não expressa recursão em regra sem Cloud
    // Function paga, então a cadeia é recalculada no cliente quando
    // gestor_uid muda e gravada como array plano de uids).
    // Ainda não chamada por nenhum match (função morta até a Fase 3 usar
    // ownerUid real nas coleções do Report Executivo) — o `firebase deploy`
    // emite avisos de "Unused function"/nomes inválidos em cascata para
    // corpos de função não referenciados; são só ruído do analisador
    // estático, não erro (rules compilaram e publicaram normalmente).
    function isInManagerChain(ownerUid) {
      let ownerDoc = get(/databases/$(database)/documents/users/$(ownerUid));
      return isActive()
        && exists(/databases/$(database)/documents/users/$(ownerUid))
        && ('cadeia_gestores' in ownerDoc.data)
        && request.auth.uid in ownerDoc.data.cadeia_gestores;
    }

    // ========================================================================
    // USERS
    // ========================================================================

    match /users/{userId} {
      // Leitura: usuários ativos (listas, delegação, rankings) e o próprio
      // usuário (necessário no login, antes da checagem de status)
      allow read: if isActive() || isOwner(userId);
      // Criação: admin cria com qualquer cargo/status. Coordenador/Gerente e
      // acima (isManager) podem cadastrar novos usuários, mas nunca com
      // cargo ADMIN. Autocriação (uid recém-criado, sem perfil ainda) só é
      // aceita em estado de menor privilégio possível — nunca ATIVO nem com
      // cargo acima de MONITOR — para impedir que alguém crie a própria
      // conta do Firebase Auth por fora do app e já se autopromova a ADMIN
      // direto no Firestore.
      allow create: if isAdmin()
        || (isManager() && request.resource.data.cargo != 'ADMIN')
        || (isOwner(userId)
          && request.resource.data.cargo == 'MONITOR'
          && request.resource.data.status == 'PENDENTE');
      // Atualização: admin controla tudo. Coordenador/Gerente e acima podem
      // editar dados básicos de qualquer usuário (nome, gestor, logos), mas
      // — assim como o próprio usuário editando o próprio perfil — NUNCA
      // podem alterar cargo ou status (isso continua exclusivo do admin,
      // é a mesma proteção anti-escalação de sempre).
      allow update: if isAdmin()
        || ((isManager() || isOwner(userId))
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['cargo', 'status']));
      allow delete: if isAdmin();
    }

    // ========================================================================
    // PÁGINAS PÚBLICAS (sem login)
    // ========================================================================

    // Mural público de depoimentos (public-feedback.html envia sem login;
    // aprovação/moderação é interna).
    // Criação anônima é validada por shape: campos e tamanhos limitados,
    // e todo envio público nasce obrigatoriamente como não-aprovado.
    match /testimonials/{document} {
      allow read: if isAuthenticated();
      allow create: if isActive()
        || (
          request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 2000
          && request.resource.data.toName is string
          && request.resource.data.toName.size() <= 120
          && (!('fromName' in request.resource.data) || (request.resource.data.fromName is string && request.resource.data.fromName.size() <= 120))
          && (!('tags' in request.resource.data) || (request.resource.data.tags is list && request.resource.data.tags.size() <= 10))
          && request.resource.data.approved == false
          && request.resource.data.keys().hasOnly(['toName', 'message', 'fromName', 'tags', 'createdAt', 'origin', 'approved', 'public'])
        );
      allow update: if isActive();
      allow delete: if isAdmin();
    }

    // Changelog público (status.html)
    match /status_updates/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notificações: página pública cria apenas o aviso de novo feedback
    // (shape estrito e tamanhos limitados); leitura/gestão para ativos
    match /notifications/{notificationId} {
      allow create: if isActive()
        || (
          request.resource.data.titulo is string
          && request.resource.data.titulo.size() <= 200
          && request.resource.data.mensagem is string
          && request.resource.data.mensagem.size() <= 500
          && request.resource.data.referencia_tipo == 'testimonials'
          && request.resource.data.keys().hasOnly(['titulo', 'mensagem', 'destinatario_uid', 'lida', 'data', 'tipo', 'referencia_tipo'])
        );

      // Leitura restrita a quem a notificação é endereçada (uid, cargo,
      // broadcast 'ALL' ou hierarquia por destinatario_cargo) ou admin —
      // impede que qualquer ativo baixe notificações de outras pessoas.
      allow read, update, delete: if isActive() && (
        isAdmin()
        || resource.data.destinatario_uid == request.auth.uid
        || resource.data.destinatario_uid == 'ALL'
        || resource.data.destinatario_uid == myProfile().cargo
        || (resource.data.destinatario_cargo != null
            && cargoLevel(resource.data.destinatario_cargo) <= cargoLevel(myProfile().cargo))
      );
    }

    // ========================================================================
    // ADMINISTRAÇÃO E PERMISSÕES
    // ========================================================================

    match /module_permissions/{moduleId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /tool_permissions/{toolId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /logos/{logoId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // Auditoria: imutável — ninguém edita ou apaga logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ========================================================================
    // OPERAÇÃO (exige perfil ATIVO)
    // ========================================================================

    // Kanban: regras granulares por campo — protege pontos, validação e prazo
    // contra manipulação direta via console do navegador.
    //
    // Campos protegidos (só admin ou gestor direto do responsável):
    //   validated, validatedBy, validatedAt, finalPoints, points,
    //   deadline, deadlineChangePenalty, priority
    //
    // Campos operacionais (responsável da tarefa):
    //   status, acknowledged, evidence, evidenceLink, deliveredAt,
    //   history, hasAttachments
    //
    // Campos descritivos (criador da tarefa):
    //   title, description, unit, owner, ownerUid, ownerRole, taskType,
    //   viewers, viewersNames, requester, updatedAt, isRecurring,
    //   recurringDay, recurringParentId, creatorName

    function tasksOnlyChanges(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    function tasksNoProtectedChanges() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        // `priority` NÃO entra aqui: é derivada de `deadline` (que é
        // protegido) e não influencia pontuação alguma. Protegê-la só
        // quebrava o salvamento — o cliente recalcula a prioridade a partir
        // da data de hoje em cada gravação, então o campo mudava sozinho com
        // o tempo e o update do criador passava a ser rejeitado.
        .hasAny(['validated', 'validatedBy', 'validatedAt',
                 'finalPoints', 'points', 'deadline',
                 'deadlineChangePenalty',
                 'taskType', 'deadlineChanged', 'basePoints']);
    }

    // Gestor DIRETO do responsável da tarefa, e nunca o próprio responsável.
    //
    // Antes, qualquer isManager() (Coordenador para cima) podia validar
    // QUALQUER tarefa — inclusive a própria. Um coordenador entregava e
    // aprovava a si mesmo pelo console, creditando os próprios pontos. A
    // regra de "só o gestor direto aprova" existia apenas no cliente, que
    // não é fronteira de segurança.
    // `ownerUid` pode vir vazio em tarefas antigas (atribuídas só por nome).
    // Montar caminho de documento com string vazia é erro de avaliação, que
    // derrubaria a regra inteira — por isso a checagem vem antes.
    function taskHasOwnerDoc() {
      return resource.data.ownerUid is string
        && resource.data.ownerUid != ''
        && exists(/databases/$(database)/documents/users/$(resource.data.ownerUid));
    }

    function isDirectManagerOfTaskOwner() {
      return isActive()
        && resource.data.ownerUid != request.auth.uid
        && taskHasOwnerDoc()
        && get(/databases/$(database)/documents/users/$(resource.data.ownerUid))
             .data.get('gestor_uid', '') == request.auth.uid;
    }

    // Responsável sem gestor cadastrado: gestor/admin destrava, senão a
    // tarefa ficaria represada para sempre por falha de cadastro.
    function taskOwnerHasNoManager() {
      return !taskHasOwnerDoc()
        || get(/databases/$(database)/documents/users/$(resource.data.ownerUid))
             .data.get('gestor_uid', '') == '';
    }

    match /tasks/{taskId} {
      allow read: if isActive();

      // Criação: ativo, sempre backlog, não-validado, próprio UID como criador
      allow create: if isActive()
        && request.resource.data.status == 'backlog'
        && request.resource.data.validated == false
        && request.resource.data.creatorUid == request.auth.uid;

      // Atualização: regras por papel
      allow update: if isActive() && (
        // Admin pode tudo
        isAdmin()
        // Gestor DIRETO do responsável: valida a entrega e ajusta prazo/tipo.
        // Trocado de isManager() (qualquer Coordenador+, em qualquer tarefa,
        // inclusive a própria) para o vínculo real de hierarquia.
        || (isDirectManagerOfTaskOwner()
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['creatorUid', 'basePoints']))
        // Gestor sem vínculo cadastrado no responsável: só destrava se de
        // fato não existe gestor (evita tarefa represada por falha de
        // cadastro) e ainda assim nunca na própria tarefa.
        || (isManager()
            && resource.data.ownerUid != request.auth.uid
            && taskOwnerHasNoManager()
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['creatorUid', 'basePoints']))
        // Topo da hierarquia entregando tarefa própria: auto-validação.
        // Diretor e Superintendente não têm gestor acima (hierarquia oficial
        // do NEP), então a entrega deles se valida sozinha. É a ÚNICA
        // autovalidação permitida, e é restrita pelo cargo de quem chama —
        // não pelo que o cliente manda.
        || (resource.data.ownerUid == request.auth.uid
            && myProfile().cargo in ['ADMIN', 'DIRETOR', 'SUPERINTENDENTE']
            && tasksOnlyChanges(['status', 'acknowledged', 'evidence',
                                 'evidenceLink', 'deliveredAt', 'history',
                                 'hasAttachments', 'updatedAt', 'validated',
                                 'validatedBy', 'validatedAt']))
        // Responsável comum: campos operacionais apenas.
        // `validated` fica FORA — é o que impede um analista de se
        // autoaprovar pelo console e creditar os próprios pontos.
        || (resource.data.ownerUid == request.auth.uid
            && tasksOnlyChanges(['status', 'acknowledged', 'evidence',
                                 'evidenceLink', 'deliveredAt', 'history',
                                 'hasAttachments', 'updatedAt']))
        // Criador: campos descritivos — NUNCA pontuação, validação ou prazo
        || (resource.data.creatorUid == request.auth.uid
            && tasksNoProtectedChanges()
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['creatorUid']))
      );

      // Exclusão: admin ou criador
      allow delete: if isAdmin()
        || (isActive() && resource.data.creatorUid == request.auth.uid);
    }
    match /deliveries/{deliveryId} { allow read, write: if isActive(); }
    match /entregas/{entregaId} { allow read, write: if isActive(); }
    match /reports/{reportId} { allow read, write: if isActive(); }

    match /vacations/{vacationId} { allow read, write: if isActive(); }
    match /vacation_requests/{requestId} { allow read, write: if isActive(); }

    // Calendário de feriados: todo ativo vê, só Coordenador+ cadastra/edita/remove
    match /holidays/{holidayId} {
      allow read: if isActive();
      allow create, update, delete: if isManager();
    }

    match /daily_routines/{docId} { allow read, write: if isActive(); }
    match /rotina_checklist/{docId} { allow read, write: if isActive(); }
    match /rotinas_adm/{docId} { allow read, write: if isActive(); }

    match /feedback_requests/{document} { allow read, write: if isActive(); }

    // ========================================================================
    // CURSOS
    // ========================================================================

    match /courses/{courseId} {
      allow read: if isActive();
      allow write: if isManager();
    }

    match /course_progress/{progressId} { allow read, write: if isActive(); }
    match /user_courses/{docId} { allow read, write: if isActive(); }

    // ========================================================================
    // COMUNICAÇÃO
    // ========================================================================

    match /announcements/{avisoId} {
      allow read: if isActive();
      allow write: if isManager();
    }

    match /push_subscriptions/{subId} {
      allow read: if isAdmin() || isOwner(subId);
      allow write: if isOwner(subId) || isAdmin();
    }

    // ========================================================================
    // FÓRUM
    // ========================================================================

    match /forum_topics/{topicId} {
      allow read, create, update: if isActive();
      allow delete: if isAdmin() || (isActive() && resource.data.author_uid == request.auth.uid);

      match /replies/{replyId} {
        allow read, create, update: if isActive();
        allow delete: if isAdmin();
      }
    }

    match /forum_replies/{replyId} {
      allow read, create, update: if isActive();
      allow delete: if isAdmin() || (isActive() && resource.data.author_uid == request.auth.uid);
    }

    // ========================================================================
    // CENTRAL DE CHAMADOS (TICKETS)
    // ========================================================================

    match /tickets/{ticketId} {
      allow read: if isActive()
        && (resource.data.created_by == request.auth.uid || resource.data.assigned_to == request.auth.uid || isAdmin());
      allow create: if isActive() && request.resource.data.created_by == request.auth.uid;
      allow update: if isActive()
        && (resource.data.created_by == request.auth.uid || resource.data.assigned_to == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (isActive() && resource.data.created_by == request.auth.uid);
    }

    // ========================================================================
    // PORTAL CORPORATIVO DE PAINÉIS HTML
    // ========================================================================

    // Aprovadores das análises (técnica/visual/segurança): COORDENADOR+
    function isPanelApprover() {
      return isActive()
        && myProfile().cargo in ['ADMIN', 'DIRETOR', 'SUPERINTENDENTE', 'GERENTE', 'CONSULTOR', 'COORDENADOR'];
    }

    // Gestão/governança (publicar, suspender, arquivar, rollback): GERENTE+
    function isPanelManager() {
      return isActive()
        && myProfile().cargo in ['ADMIN', 'DIRETOR', 'SUPERINTENDENTE', 'GERENTE'];
    }

    match /panels/{panelId} {
      allow read: if isActive();
      // Criação: qualquer ativo, sempre como dono e nunca já publicado
      allow create: if isActive()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status in ['RASCUNHO', 'EM_ANALISE'];
      // Atualização: gestão controla tudo; dono atualiza o próprio painel
      // MAS não pode se autopublicar; qualquer ativo só incrementa views
      allow update: if isPanelManager()
        || (isActive()
          && resource.data.ownerUid == request.auth.uid
          && !(request.resource.data.status == 'PUBLICADO' && resource.data.status != 'PUBLICADO'))
        || (isActive()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']));
      allow delete: if isAdmin();

      match /versions/{versionId} {
        allow read: if isActive();
        // Envio de versão: autor real da sessão, sempre em análise
        allow create: if isActive()
          && request.resource.data.submittedByUid == request.auth.uid
          && request.resource.data.status == 'EM_ANALISE';
        // Pareceres/publicação: aprovador que NÃO seja o dono do painel
        // (segregação autor × aprovador garantida no servidor)
        allow update: if (
            isPanelApprover()
            && get(/databases/$(database)/documents/panels/$(panelId)).data.ownerUid != request.auth.uid
          ) || isPanelManager() || isAdmin();
        allow delete: if isAdmin();
      }
    }

    match /panel_favorites/{favId} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.uid == request.auth.uid;
      allow delete: if isActive() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /panel_reports/{reportId} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.uid == request.auth.uid;
      allow update: if isActive();
      allow delete: if isAdmin();
    }

    // ========================================================================
    // GAMIFICAÇÃO E ANALYTICS
    // ========================================================================

    match /analytics/{document=**} { allow read, write: if isActive(); }
    match /user_analytics/{docId} { allow read, write: if isActive(); }
    match /user_data/{docId} { allow read, write: if isActive(); }

    // Coleção legada: nenhum código escreve nela, mas os painéis do Admin
    // ainda a leem (top 5 do ranking). Somente-leitura para não virar porta
    // de entrada de dado falso num painel de gestão.
    match /points/{docId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------------
    // COFRE DE PONTOS
    //
    // Limitação conhecida: no plano Spark não há Cloud Functions, e vários
    // fluxos legítimos exigem que o próprio usuário grave os próprios pontos
    // (fórum, cursos, relatórios, rotinas, chamados). Por isso NÃO é possível
    // bloquear a auto-premiação sem quebrar o sistema — a regra não distingue
    // "o app chamou" de "o console chamou".
    //
    // O que dá para fazer, e está feito aqui: limitar o ESTRAGO por escrita.
    // A maior premiação legítima única é 150 (conquista/curso), então o teto
    // de 200 não afeta nenhum fluxo real, mas impede o golpe de uma tacada
    // ("me dou 999999"). Quem quiser fraudar precisa de centenas de escritas,
    // cada uma deixando rastro no ledger append-only abaixo — que é
    // exatamente o que o detector de fraude do painel Admin procura.
    // ------------------------------------------------------------------

    // O saldo precisa ser um número não-negativo e o doc referir-se a si mesmo
    function pointsShapeOk(userId) {
      return request.resource.data.uid == userId
        && request.resource.data.total_points is number
        && request.resource.data.total_points >= 0;
    }

    match /user_points/{userId} {
      allow read: if isActive();

      // Admin ignora o teto: recálculo e correção retroativa gravam totais cheios
      allow create: if isAdmin()
        || (isActive() && pointsShapeOk(userId)
            && request.resource.data.total_points <= 200);

      allow update: if isAdmin()
        || (isActive() && pointsShapeOk(userId)
            && request.resource.data.total_points <= resource.data.total_points + 200
            && request.resource.data.total_points >= resource.data.total_points - 200);

      allow delete: if isAdmin();
    }

    // Ledger append-only: só o admin altera ou apaga histórico.
    match /points_transactions/{transactionId} {
      allow read: if isActive();
      allow create: if isAdmin() || (isActive()
        && request.resource.data.points is number
        && request.resource.data.points <= 200
        && request.resource.data.points >= -200);
      allow update, delete: if isAdmin();
    }

    match /user_stats/{userId} { allow read, write: if isActive(); }
    match /user_achievements/{uid} { allow read, write: if isActive(); }

    match /achievements/{achievementId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ========================================================================
    // REPORT EXECUTIVO (módulo portado — ver plano de integração)
    // ========================================================================

    // "items" é a coleção central (equivalente a `items` do Report
    // Executivo) usada pelas abas Arquivados/Board/Riscos e, nas próximas
    // fases, Carteira/Dashboard/Capacidade. NOTA: nesta fase a atribuição de
    // responsável é só texto livre (ownerName) — ainda não há um campo
    // ownerUid confiável para acionar isInManagerChain()/isDirectManagerOf
    // aqui. Enquanto isso, a escrita é liberada a qualquer usuário ativo
    // não-somente-leitura, e a exclusão fica restrita a quem criou ou a
    // gestão, para não travar o uso real do Board antes da Fase 2 introduzir
    // atribuição por uid.
    match /items/{itemId} {
      allow read: if isActive();
      allow create: if isActive() && !isReportExecutivoReadOnly()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isActive() && !isReportExecutivoReadOnly();
      allow delete: if isAdmin() || isManager()
        || (isActive() && resource.data.createdBy == request.auth.uid);
    }

    // "events" — Agenda do Report Executivo (CRUD simples de compromissos).
    match /events/{eventId} {
      allow read: if isActive();
      allow create: if isActive() && !isReportExecutivoReadOnly()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin() || isManager()
        || (isActive() && resource.data.createdBy == request.auth.uid);
    }

    // "process_improvements" — funil de melhoria de processo (aba Melhorias).
    match /process_improvements/{improvementId} {
      allow read: if isActive();
      allow create: if isActive() && !isReportExecutivoReadOnly()
        && request.resource.data.requestedBy == request.auth.uid;
      // Avançar de estágio é uma ação de gestão (equivale a canManageImprovementStatus
      // no Report Executivo); quem solicitou só edita os próprios campos antes de
      // sair do estágio inicial.
      allow update: if isAdmin() || isManager()
        || (isActive() && resource.data.requestedBy == request.auth.uid
            && resource.data.stage == 'Solicitação');
      allow delete: if isAdmin() || isManager();
    }

    // "improvement_movements" — histórico imutável de transição de estágio;
    // só é criado pelo código no momento da transição, nunca editado/apagado.
    match /improvement_movements/{movementId} {
      allow read: if isActive();
      allow create: if isActive() && !isReportExecutivoReadOnly()
        && request.resource.data.movedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // "materials" — repositório de materiais com avaliação por rubrica (aba
    // Materiais). Nesta fase a nota é um cálculo determinístico local (sem
    // IA), então o critério de escrita é simples: qualquer usuário ativo
    // não-somente-leitura cadastra; gestão edita/reavalia.
    match /materials/{materialId} {
      allow read: if isActive();
      allow create: if isActive() && !isReportExecutivoReadOnly()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin() || isManager()
        || (isActive() && resource.data.createdBy == request.auth.uid);
    }

    // "absences" — férias/ausências usadas pela aba Capacidade. Cadastro
    // restrito a quem gerencia pessoas (mesmo corte de canManagePeople do
    // Report); leitura liberada porque a aba de carga precisa dela pra todo
    // mundo ver utilização de time.
    match /absences/{absenceId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin()
        || (isActive() && myProfile().cargo == 'SUPERINTENDENTE');
    }

    // "routines" e "routine_runs" — rotina de processo atribuída (aba
    // Rotinas). Só gestão cria/edita a rotina em si; o responsável marca a
    // própria execução.
    match /routines/{routineId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin() || isManager();
    }
    match /routine_runs/{runId} {
      allow read: if isActive();
      allow create, update: if isActive() && !isReportExecutivoReadOnly();
      allow delete: if isAdmin() || isManager();
    }

    // "personal_tasks" — lista pessoal do dia. Isolamento estrito: só o
    // dono lê/escreve, SEM exceção para admin/diretor/superintendente
    // (mesma decisão do Report Executivo — não é dado gerencial, é uma
    // lista de afazeres auto-declarada).
    match /personal_tasks/{taskId} {
      allow read, update, delete: if isActive() && resource.data.userId == request.auth.uid;
      allow create: if isActive() && request.resource.data.userId == request.auth.uid;
    }

    // "okr_objectives"/"okr_targets"/"okr_measurements" — ciclo de OKR
    // completo (Decisão do usuário: portar OKR por inteiro). Dono do
    // objetivo e gestão podem escrever; leitura liberada a todos os ativos
    // (a aba já filtra "Meu OKR" vs visão de gestão no client).
    match /okr_objectives/{objectiveId} {
      allow read: if isActive();
      allow create: if isActive() && !isReportExecutivoReadOnly()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin() || isManager()
        || (isActive() && resource.data.ownerUid == request.auth.uid);
    }
    match /okr_targets/{targetId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin() || isManager()
        || (isActive() && !isReportExecutivoReadOnly());
    }
    match /okr_measurements/{measurementId} {
      allow read: if isActive();
      allow create: if isActive() && !isReportExecutivoReadOnly();
      allow update, delete: if isAdmin() || isManager();
    }

    // "executive_decisions" — rastreio de decisões executivas (aba
    // Executivo). Gestão cria/edita; leitura liberada (transparência).
    match /executive_decisions/{decisionId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin() || isManager();
    }

    // "user_pdis" — plano de desenvolvimento individual, auto-administrado
    // (aba Desenvolvimento). Só o dono edita o próprio; gestão só lê.
    match /user_pdis/{pdiId} {
      allow read: if isActive();
      allow create, update: if isActive() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isActive() && resource.data.userId == request.auth.uid);
    }

    // "one_on_ones" — atas de 1:1. Só gestor e colaborador envolvidos leem;
    // só o gestor que fez a ata escreve (mesmo padrão do Report).
    match /one_on_ones/{oneOnOneId} {
      allow read: if isActive() && (
        resource.data.managerUid == request.auth.uid
        || resource.data.collaboratorUid == request.auth.uid
        || isAdmin()
      );
      allow create: if isActive() && !isReportExecutivoReadOnly()
        && request.resource.data.managerUid == request.auth.uid;
      allow update, delete: if isAdmin()
        || (isActive() && resource.data.managerUid == request.auth.uid);
    }

    // ========================================================================
    // DEFAULT DENY
    // ========================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
